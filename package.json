{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": "https://github.com/p3ol/oak.git",
  "scripts": {
    "prepack": "yarn build && yarn lint && yarn tsc && yarn test",
    "preversion": "yarn prepack",
    "release": "lerna version",
    "release:publish": "lerna publish from-package --yes",
    "lint": "oxlint",
    "test": "vitest run",
    "build": "turbo build",
    "dev": "storybook dev",
    "serve": "yarn dev",
    "p:core": "yarn workspace @oakjs/core",
    "p:react": "yarn workspace @oakjs/react",
    "p:ckeditor": "yarn workspace @oakjs/ckeditor5-build-custom",
    "p:addon-ckeditor": "yarn workspace @oakjs/addon-ckeditor5-react",
    "p:addon-remirror": "yarn workspace @oakjs/addon-remirror",
    "p:theme": "yarn workspace @oakjs/theme",
    "p:strapi": "yarn workspace @oakjs/strapi-plugin"
  },
  "devDependencies": {
    "@ckeditor/ckeditor5-react": "12.0.0",
    "@junipero/core": "3.14.1",
    "@junipero/tailwind-plugin": "3.15.2",
    "@percy/storybook": "10.0.4",
    "@poool/oxlint-config": "6.3.0",
    "@remirror/pm": "3.0.1",
    "@remirror/react": "3.0.3",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "autoprefixer": "10.6.2",
    "ckeditor5": "49.0.1",
    "commitlint": "21.2.4",
    "css-loader": "7.1.5",
    "eslint": "10.14.0",
    "eslint-plugin-storybook": "10.6.5",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "lerna": "10.1.1",
    "oxlint": "1.90.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remirror": "3.0.3",
    "sass": "1.107.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.4",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "yarn@4.18.1"
}
