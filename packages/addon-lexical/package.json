{
  "name": "@oakjs/addon-lexical",
  "version": "3.16.3",
  "description": "🌳 Lexical rich text field for oak",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/p3ol/oak.git",
    "directory": "packages/addon-lexical"
  },
  "author": "Ugo Stephant <ugo@poool.fr>",
  "contributors": [
    "Maxime Da Silva <maximed@poool.fr>"
  ],
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">= 20"
  },
  "peerDependencies": {
    "@junipero/react": "^3.0.0",
    "@lexical/html": "^0.53.0",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/selection": "^0.53.0",
    "@lexical/table": "^0.53.0",
    "@lexical/utils": "^0.53.0",
    "@oakjs/core": "^3.0.0",
    "lexical": "^0.53.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@lexical/html": "0.53.0",
    "@lexical/link": "0.53.0",
    "@lexical/list": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/selection": "0.53.0",
    "@lexical/table": "0.53.0",
    "@lexical/utils": "0.53.0",
    "@oakjs/core": "workspace:*",
    "lexical": "0.53.0"
  },
  "scripts": {
    "clean": "rm -rf ./dist || true",
    "build": "yarn clean && yarn build:code && yarn build:dts && yarn build:styles",
    "build:code": "yarn run -T tsdown",
    "build:dts": "yarn run -T tsc --project ./tsconfig.build.json",
    "build:styles": "node --import=tsx ../../scripts/build-css.ts --sass ./lib/index.sass ./dist/oak-addon-lexical.min.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./addons": {
      "types": "./dist/types/addons.d.ts",
      "import": "./dist/addons.js",
      "require": "./dist/addons.cjs"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "targets": [
    "chrome109",
    "edge138",
    "firefox140",
    "safari18",
    "opera80",
    "node20"
  ]
}
