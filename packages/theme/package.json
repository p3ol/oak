{
  "name": "@oakjs/theme",
  "version": "3.16.2",
  "description": "🌳 Modern, lightweight & modulable page builder",
  "main": "dist/oak.min.css",
  "cdn": "dist/oak.min.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/p3ol/oak.git",
    "directory": "packages/theme"
  },
  "author": "Ugo Stephant <ugo@poool.fr>",
  "contributors": [
    "Maxime Da Silva <maximed@poool.fr>"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">= 20"
  },
  "dependencies": {
    "@junipero/theme": "3.13.1"
  },
  "scripts": {
    "clean": "rm -rf ./dist || true",
    "build": "yarn clean && yarn build:code",
    "build:code": "yarn build:components && yarn build:index",
    "build:components": "node --import=tsx ../../scripts/build-css.ts --sass --load-path ./lib/utils ./lib ./dist/css",
    "build:index": "node --import=tsx ../../scripts/build-css.ts --sass --load-path ./lib/utils ./lib/index.sass ./dist/oak.min.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "d75c061fe25d641c27268b3995ede1b047369787"
}
