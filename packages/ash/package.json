{
  "name": "@oakjs/ash",
  "version": "3.16.3",
  "description": "🌳 Canvas-based visual page builder for oak",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/p3ol/oak.git",
    "directory": "packages/ash"
  },
  "author": "Ugo Stephant <ugo@poool.fr>",
  "contributors": [
    "Maxime Da Silva <maximed@poool.fr>"
  ],
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">= 20"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@junipero/core": "3.14.1",
    "@junipero/hooks": "3.15.2",
    "@junipero/react": "3.15.2",
    "@junipero/theme": "3.13.1",
    "@junipero/transitions": "3.15.2",
    "@oakjs/core": "^3.16.2",
    "@oakjs/react-renderer": "^3.16.3",
    "re-resizable": "6.11.2",
    "uuid": "14.0.3"
  },
  "scripts": {
    "clean": "rm -rf ./dist || true",
    "build": "yarn clean && yarn build:code && yarn build:dts && yarn build:css",
    "build:code": "yarn run -T tsdown",
    "build:dts": "yarn run -T tsc --project ./tsconfig.build.json",
    "build:css": "node --import=tsx ../../scripts/build-css.ts ./lib/index.css ./dist/oak-ash.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./addons": {
      "types": "./dist/types/addons.d.ts",
      "import": "./dist/addons.js",
      "require": "./dist/addons.cjs"
    },
    "./styles.css": "./dist/oak-ash.css"
  },
  "files": [
    "dist"
  ],
  "targets": [
    "chrome109",
    "edge138",
    "firefox140",
    "safari18",
    "opera80",
    "node20"
  ]
}
