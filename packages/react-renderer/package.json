{
  "name": "@oakjs/react-renderer",
  "version": "3.16.3",
  "description": "🌳 React renderer for oak page builder content",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/p3ol/oak.git",
    "directory": "packages/react-renderer"
  },
  "author": "Ugo Stephant <ugo@poool.fr>",
  "contributors": [
    "Maxime Da Silva <maximed@poool.fr>"
  ],
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">= 20"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@junipero/core": "3.14.1"
  },
  "scripts": {
    "clean": "rm -rf ./dist || true",
    "build": "yarn clean && yarn build:code && yarn build:dts && yarn build:css",
    "build:code": "yarn run -T tsdown",
    "build:dts": "yarn run -T tsc --project ./tsconfig.build.json",
    "build:css": "node --import=tsx ../../scripts/build-css.ts ./lib/index.css ./dist/oak-renderer.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/oak-renderer.css",
    "./tailwind.css": "./lib/tailwind.css"
  },
  "files": [
    "dist",
    "lib/tailwind.css"
  ],
  "targets": [
    "chrome109",
    "edge138",
    "firefox140",
    "safari18",
    "opera80",
    "node20"
  ]
}
